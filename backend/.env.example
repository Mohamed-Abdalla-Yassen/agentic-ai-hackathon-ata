# Copy to .env and fill in real values — nothing here has a default in code,
# the app refuses to start if any of these are missing.

# Path to the SQLite database file (created by seed.py)
DATABASE_PATH=./data/spacematch.db

# Secret used to sign JWTs — any random string works for local dev
JWT_SECRET=

# --- AI provider for the search ranking call -------------------------------
# Which provider to use: anthropic (default) or openai.
# "openai" means any OpenAI-compatible /chat/completions endpoint, not just
# OpenAI itself — set OPENAI_BASE_URL to pick the host.
AI_PROVIDER=anthropic

# --- AI_PROVIDER=anthropic -------------------------------------------------
# Anthropic API key (sent as x-api-key). Alternatively set
# ANTHROPIC_AUTH_TOKEN to authenticate with a bearer token instead; the key
# wins if both are set.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# Claude model id used for search ranking
ANTHROPIC_MODEL=claude-opus-5

# Optional — overrides the Anthropic endpoint (e.g. a compatible gateway)
ANTHROPIC_BASE_URL=

# --- AI_PROVIDER=openai ----------------------------------------------------
# API key for the OpenAI-compatible provider
OPENAI_API_KEY=

# Model id offered by that provider (e.g. gpt-oss-20b, gpt-4o-mini, llama3)
OPENAI_MODEL=gpt-oss-20b

# Optional — endpoint for the provider. Unset means OpenAI's own API.
# SovereignEG: https://backend.sovereigneg.com/v1
# Local Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=https://backend.sovereigneg.com/v1

# --- Rate limiting (all optional; the values below are the built-in defaults) ---
# Login/register attempts per client IP per hour
RATE_LIMIT_AUTH_PER_HOUR=30
# Free authenticated requests per user per minute
RATE_LIMIT_READ_PER_MINUTE=60
# AI-backed searches per booker, per hour and per day
RATE_LIMIT_AI_PER_HOUR=20
RATE_LIMIT_AI_PER_DAY=100
# Hard ceiling on AI-backed searches per day across ALL users — the cap that
# actually bounds daily Anthropic spend
RATE_LIMIT_AI_GLOBAL_PER_DAY=500
# Set to 1 ONLY when behind a proxy that overwrites X-Forwarded-For
TRUST_PROXY_HEADERS=0

# --- Photo uploads (optional; values below are the built-in defaults) ---
# Where uploaded images are written
UPLOAD_DIR=./data/uploads
# Largest accepted image, in bytes (5 MB)
MAX_PHOTO_BYTES=5242880
# Photos allowed per room
MAX_PHOTOS_PER_ROOM=8
# Uploads allowed per owner per hour
RATE_LIMIT_UPLOAD_PER_HOUR=60
